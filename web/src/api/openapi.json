          },
          "lastVerifiedRestoreAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time",
            "description" : "When a restore was last verified successfully; null if never"
          }
        },
        "required" : [ "lastVerifiedRestoreAt", "version" ]
      }
    }
