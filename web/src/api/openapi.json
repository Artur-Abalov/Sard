                  "$ref" : "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "StatusResponse" : {
        "type" : "object",
        "properties" : {
          "version" : {
            "type" : "string",
