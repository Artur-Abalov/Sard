{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Network device",
  "type": "object",
  "properties": {
    "host": { "type": "string", "title": "Host" },
    "port": { "type": "integer", "title": "SSH port", "minimum": 1, "maximum": 65535, "default": 22 },
    "vendor": { "type": "string", "title": "Vendor", "enum": ["mikrotik", "eltex"] },
    "username": { "type": "string", "title": "SSH user" }
  },
  "required": ["host", "vendor", "username"],
  "additionalProperties": false
}
