# Settings and secrets of deploy/docker-compose.yml. Copy to deploy/.env,
# keep it readable by its owner only (chmod 600) and fill in the values marked
# <...>. deploy/.env is git-ignored; secrets live nowhere else.

# --- Image ---------------------------------------------------------------
# Server version to run: a tag of ghcr.io/artur-abalov/sard-server without the
# leading "v" (releases: https://github.com/Artur-Abalov/Sard/releases).
SARD_VERSION=0.0.1-rc.1
# Image repository; change only for a mirror or a locally loaded image.
# SARD_IMAGE=ghcr.io/artur-abalov/sard-server
# PostgreSQL image; the offline archive carries this exact tag.
# SARD_POSTGRES_IMAGE=postgres:18-alpine

# --- Secrets -------------------------------------------------------------
# PostgreSQL password, used only inside the compose network.
# Generate one: openssl rand -hex 24
SARD_DB_PASSWORD=<DB_PASSWORD>
# The single administrator's password (ADR 0021); at least 12 Unicode code
# points, or the server refuses to start. Generate one: openssl rand -hex 16
# The first `make up` (development) fills this in with a random value and
# prints the path to this file, never the password itself.
SARD_ADMIN_PASSWORD=

# --- Names and ports -----------------------------------------------------
# Names agents use to reach the server, comma-separated DNS names and IPs;
# they go into its TLS certificate. Default: localhost,127.0.0.1,::1
# SARD_PKI_SERVER_NAMES=<sard.example.com>
# Address agents dial (host[:port]); its host must be one of the names above.
# Empty means the first of SARD_PKI_SERVER_NAMES and port 9090.
# SARD_AGENT_ENDPOINT=<sard.example.com>:9090
# Host side of the published ports: [address:]port. The HTTP port carries
# the administrator password in plain HTTP, so it listens on the loopback
# only by default; 0.0.0.0:8080 opens it to the network.
# SARD_HTTP_PUBLISH=127.0.0.1:8080
# Agents' port (gRPC, mutual TLS): open to the agents' hosts. Forward it as
# plain TCP only; a proxy that terminates TLS breaks the agents' certificates.
# SARD_GRPC_PUBLISH=9090

# --- Notifications -------------------------------------------------------
# Telegram notifications about finished runs (S9a, ADR 0024). Set both or
# neither: empty means notifications are off and the server logs a warning.
# The token is a secret: it never appears in the server's logs or database.
SARD_TELEGRAM_BOT_TOKEN=
# SARD_TELEGRAM_CHAT_ID=<-1001234567890>
