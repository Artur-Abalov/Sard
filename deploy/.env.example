# Settings and secrets of deploy/docker-compose.yml. Copy to deploy/.env,
# keep it readable by its owner only (chmod 600) and fill in the values marked
# <...>. deploy/.env is git-ignored; secrets live nowhere else.

# --- Image ---------------------------------------------------------------
# Server version to run: a tag of ghcr.io/artur-abalov/sard-server without the
# leading "v" (releases: https://github.com/Artur-Abalov/Sard/releases).
SARD_VERSION=0.0.1-rc.1
# Image repository; change only for a mirror or a locally loaded image.
# SARD_IMAGE=ghcr.io/artur-abalov/sard-server
# The agent next to the server (sard-self, docs/operations/self-agent.md): the
# same version, from this repository; change only for a mirror or a local image.
# SARD_AGENT_IMAGE=ghcr.io/artur-abalov/sard-agent
# PostgreSQL image, pinned by digest (docs/operator/16-postgresql.md). An offline installation names the
# tag the archive carries, the part before "@" (docs/operator/11-offline.md).
# SARD_POSTGRES_IMAGE=postgres:18.6-alpine@sha256:898c60cb390d1085bc97bdd6a1ae968757421df394b071848b52b1c09c89d6a5

# --- Secrets -------------------------------------------------------------
# There are no database passwords here (DB2): db-init makes one for each role of Sard on the first `docker compose
# up` and keeps it in a volume that only the one service using it mounts (docs/operator/16-postgresql.md). The
# superuser's password is random and kept nowhere. There is no administrator password either: the first start asks
# for it in the console, with the setup code from `docker compose logs server`.

# --- Names and ports -----------------------------------------------------
# Names agents use to reach the server, comma-separated DNS names and IPs;
# they go into its TLS certificate. Default: localhost,127.0.0.1,::1
# SARD_PKI_SERVER_NAMES=<sard.example.com>
# Address agents dial (host[:port]); its host must be one of the names above.
# Empty means the first of SARD_PKI_SERVER_NAMES and port 9090.
# SARD_AGENT_ENDPOINT=<sard.example.com>:9090
# Host side of the published ports: [address:]port. The HTTP port carries
# the setup code and the administrator password in plain HTTP, so it listens on
# the loopback only by default; 0.0.0.0:8080 opens it to the network. The agents' hosts
# download their packages from this port too (U1b) unless
# SARD_AGENT_DOWNLOADS_URL points elsewhere: on loopback only, the install
# commands the console shows do not work from another host (OQ-144).
# SARD_HTTP_PUBLISH=127.0.0.1:8080
# Agents' port (gRPC, mutual TLS): open to the agents' hosts. Forward it as
# plain TCP only; a proxy that terminates TLS breaks the agents' certificates.
# SARD_GRPC_PUBLISH=9090
# Behind a reverse proxy that terminates TLS (Cloudflare Tunnel, nginx, Caddy)
# on this host: native trusts X-Forwarded-Proto and X-Forwarded-For from
# loopback and private addresses, so console sign-in works over https and the
# session cookie gets Secure (ADR 0046). Keep SARD_HTTP_PUBLISH on the loopback
# then: anyone who reaches port 8080 from a private network could forge them.
# Default none ignores those headers. No other value is supported.
# SARD_FORWARD_HEADERS=native

# --- Time zone -----------------------------------------------------------
# The server's time zone, an IANA name such as Europe/Berlin. A backup schedule
# without a zone of its own is read in it, and the console shows it as the
# default. Default UTC. Anything that is not an IANA name (a bare offset such
# as +03:00) is read as UTC.
# TZ=Europe/Berlin

# --- Notifications -------------------------------------------------------
# Telegram notifications about finished runs (S9a, ADR 0024). Set both or
# neither: empty means notifications are off and the server logs a warning.
# The token is a secret: it never appears in the server's logs or database.
SARD_TELEGRAM_BOT_TOKEN=
# SARD_TELEGRAM_CHAT_ID=<-1001234567890>
# --- Console and agent packages -------------------------------------------
# What the notification says (S9b). The address people open the console at: the
# message ends with <address>/runs/<run id>. Empty means no link. An absolute
# http or https address with a host, no query, no fragment; anything else stops
# the server at start. It is never taken from the request headers.
# SARD_CONSOLE_PUBLIC_URL=https://<sard.example.com>
# The language of the notification text: en (default) or ru; anything else
# stops the server at start.
# SARD_NOTIFY_LANGUAGE=en
# The server hands out the agent packages of its own version at
# /downloads/agent/, without a session (docs/release.md); false switches that off.
# SARD_AGENT_DOWNLOADS=false
# Where hosts fetch the packages from in the install commands the console shows
# (U1b, docs/operations/agent-install.md). An absolute http or https address
# without a query or a fragment, e.g. the address of a reverse proxy with TLS;
# anything else stops the server at start. Empty means http, the host of
# SARD_AGENT_ENDPOINT (or the first SARD_PKI_SERVER_NAMES) and port 8080. It is
# never taken from the request headers.
# SARD_AGENT_DOWNLOADS_URL=https://sard.example.com

# --- Metrics --------------------------------------------------------------
# Prometheus metrics on a listener of their own (docs/operator/14-monitoring.md). By default it listens on the
# loopback inside the server's container and docker-compose does not publish its port, so nothing outside the
# container reaches it. HTTP without TLS: open it to the network only with a token, and only on an address of
# your own network.
# Address of the listener inside the container: an IPv4 or IPv6 address, not a name. Default 127.0.0.1.
# Anything but a loopback address (0.0.0.0 included) needs SARD_METRICS_TOKEN or the server does not start.
# SARD_METRICS_BIND=0.0.0.0
# Port of the listener inside the container, 1 to 65535 other than 8080 and 9090. Default 8081.
# SARD_METRICS_PORT=8081
# Bearer token, at least 32 characters; Prometheus sends it as Authorization: Bearer <token>. A secret: it never
# appears in the server's logs, in the metrics or in actuator. Empty means none (loopback only).
# Generate one: openssl rand -hex 24
# SARD_METRICS_TOKEN=
# How often the gauges of the installation's state (last success of each source, agents, queues, certificates,
# self-backup) are read from the database; a scrape reads memory only. Default 60s.
# SARD_METRICS_STATE_INTERVAL=60s
