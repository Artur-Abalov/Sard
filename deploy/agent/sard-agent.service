#
# systemd unit for sard-agent. The agent only dials out to the server;
# it opens no listening ports.
[Unit]
Description=Sard backup agent
Documentation=https://github.com/Artur-Abalov/sard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sard-agent
Group=sard-agent
ExecStart=/usr/bin/sard-agent --config /etc/sard/agent.yaml
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
# /var/lib/sard-agent and restic's cache /var/cache/sard/restic
# (restic.cache_dir), created and made writable by systemd. ProtectSystem
# keeps every other path read-only: a different restic.cache_dir needs a
# drop-in (systemctl edit sard-agent) with ReadWritePaths=<that directory>.
StateDirectory=sard-agent
CacheDirectory=sard/restic
# Keep the directory private as the package made it: systemd would set 0755.
CacheDirectoryMode=0700

[Install]
WantedBy=multi-user.target
