#
# What a release is known by (D24, SC1): the registry names of the images and the public keys
# that sign them. The one place to change them; sourced by release.yml, security.yml and the
# release scripts. deploy/docker-compose.yml and deploy/.env.example carry copies of the names,
# because a release ships them on their own; scripts/check-identity.sh fails when one differs.

# The images, without tag or digest.
SARD_REGISTRY_SERVER=ghcr.io/artur-abalov/sard-server
SARD_REGISTRY_AGENT=ghcr.io/artur-abalov/sard-agent

# The keys, relative to the repository: minisign over SHA256SUMS and SHA256SUMS.server, cosign over the images.
SARD_MINISIGN_PUBLIC_KEY=deploy/release/sard-release.pub
SARD_COSIGN_PUBLIC_KEY=deploy/release/cosign.pub
