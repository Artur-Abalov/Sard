#
# The PostgreSQL of a Sard installation (D25, docs/adr/00XX-draft-embedded-postgresql.md): the one place its
# version is chosen. Read by scripts (sourced), the Makefile and the tests. deploy/docker-compose.yml and
# deploy/.env.example carry copies, because a release ships them on their own, and docker-compose.build.yml
# one as its default; DeployPostgresTest fails when a copy differs from this file.
#
# A new version: change both images together (the same minor) and every copy; DeployPostgresTest checks them.

# The server's database. A digest of the multi-arch index, so amd64 and arm64 get the same build.
SARD_POSTGRES_IMAGE=postgres:18.6-alpine@sha256:898c60cb390d1085bc97bdd6a1ae968757421df394b071848b52b1c09c89d6a5

# The base of the "-pg18" agent image (F6): its pg_dump is of the same version as the server above, never older.
SARD_AGENT_PG_BASE_IMAGE=postgres:18.6-trixie@sha256:edb0c08dc33befd0262ab3b5cf1c4f3f8cfd8b09e88c05b45adee29d6761ddb6

# initdb of a new installation, an empty volume only: page checksums, UTF8 and the built-in C.UTF-8 locale.
SARD_POSTGRES_INITDB_ARGS="--data-checksums --encoding=UTF8 --locale-provider=builtin --builtin-locale=C.UTF-8 --locale=C.UTF-8"
