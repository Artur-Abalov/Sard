#
# Images the tests run (SC1, ADR 00XX-draft-supply-chain): the one place they are pinned, each a tag for
# the reader and the digest of its multi-arch index for the build. Renovate updates the digests by PR.
# The images of an installation are in deploy/postgres.env, the bases of our images in their Dockerfiles.
#
# A test names an image by its tag ("debian:12") and gets the pinned reference: scripts/lib/test-image.sh
# for scripts, TestImages in the Kotlin tests. A tag missing here fails the test rather than pulling it.

# Hosts of the package install tests (scripts/test-agent-install.sh, test-console-install.sh, test/packages).
TEST_IMAGE_DEBIAN_12=debian:12@sha256:854dd8ab51d62866dbd8f5431d15ce77b12983a2a4a1e1fe43a2395dc7ef9f61
TEST_IMAGE_DEBIAN_13=debian:13@sha256:4c25275446ca371766b8b093c696782eabce06263fccacb8d5d813b3dc44b308
TEST_IMAGE_UBUNTU_22_04=ubuntu:22.04@sha256:0a9887931b0e38af2e3487ed39e29436b0535c4f3f52e57745baaf79d1898956
TEST_IMAGE_UBUNTU_24_04=ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
TEST_IMAGE_ROCKY_9=rockylinux/rockylinux:9@sha256:8101994123cf3d0a8fee517bee7f39e555c7d92bd2d9eb3303cc988a0eeed00f

# PostgreSQL servers other than the installation's: sources of the plugin tests, external databases.
TEST_IMAGE_POSTGRES_14=postgres:14@sha256:8ab94f61668dc73bbab4dc13273ff2fc37e635536af62aef5306a49a9682a446
TEST_IMAGE_POSTGRES_15=postgres:15@sha256:baa22e6286bf832cb147b8bb5aa9d8bc999846d69c21d11bf63f58fbeed1fa48
TEST_IMAGE_POSTGRES_16=postgres:16@sha256:9e2cf6287f25c3151f4c9421ccce2b17f3e60061c111a29165e0d2cdd9ff0a97
TEST_IMAGE_POSTGRES_18=postgres:18@sha256:edb0c08dc33befd0262ab3b5cf1c4f3f8cfd8b09e88c05b45adee29d6761ddb6

# The S3 storage of the e2e tests.
TEST_IMAGE_GARAGE=dxflrs/garage:v2.1.0@sha256:4c9b34c113e61358466e83fd6e7d66e6d18657ede14b776eb78a93ee8da7cf6a
