#
# sard-agent image of the verifier of the e2e tests (V5): the very sard-agent
# and restic of the release packages plus the Docker CLI, which starts the
# sandbox of a check through the socket of the stand's daemon, as a verifier
# host does through its own (docs/operator/17-verifier.md). Build context: the
# unpacked tarball of `make package` with an empty directory "empty/".

FROM docker:28-cli@sha256:625d9431a9f54c5a2bc90f24f0e1c3d55b1349fd857dd85035f98c2c9acbdd4d AS cli

FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
COPY --from=cli /usr/local/bin/docker /usr/bin/docker
COPY sard-agent restic /usr/libexec/sard/
COPY LICENSE LICENSE.restic THIRD_PARTY_LICENSES NOTICE /usr/share/doc/sard-agent/
COPY agent.example.yaml /etc/sard/
# The user of the packages: uid 65532, as in the other agent images (TarFiles.AGENT_UID).
RUN useradd --system --uid 65532 --user-group --home-dir /var/lib/sard-agent --no-create-home --shell /usr/sbin/nologin sard-agent
COPY --chown=65532:65532 --chmod=0700 empty/ /var/lib/sard-agent/
COPY --chown=65532:65532 --chmod=0700 empty/ /var/cache/sard/restic/
USER 65532:65532
ENTRYPOINT ["/usr/libexec/sard/sard-agent"]
CMD ["--config", "/etc/sard/agent.yaml"]
