# The virtual machine of scripts/test-agent-install-vm.sh: Oracle Linux 9's
# KVM template (cloud-init, SELinux enforcing), the image and SHA-256 from
# https://yum.oracle.com/templates/OracleLinux/ol9-template.json. A new
# update (u9…) changes both lines together.
VM_DISTRO=oraclelinux:9
VM_IMAGE_URL=https://yum.oracle.com/templates/OracleLinux/OL9/u8/x86_64/OL9U8_x86_64-kvm-b293.qcow2
VM_IMAGE_SHA256=b12103391327abee8090686759c0d62dac9a7af2bf0f45fdf6b0d085a0fbb52b
