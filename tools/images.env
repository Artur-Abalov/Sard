#
# Container images of the CI tools (SC1, ADR 00XX-draft-supply-chain): the one place they are pinned,
# by the digest of their multi-arch index; Renovate updates them by PR. Sourced by the scripts that run them.

# grype: vulnerabilities in dependencies and images (scripts/vuln-scan.sh).
TOOL_IMAGE_GRYPE=anchore/grype:v0.121.0@sha256:621d56d1d68106b787022c81546f7e0a36202a25d1239f0c20195fab8c16f7ea
# syft: the SBOM of images and packages (release.yml).
TOOL_IMAGE_SYFT=anchore/syft:v1.55.0@sha256:4cc92b64ca74ffca4c94d4c8fcc01f217731375300be14d0b6eeb2e82eaa110a
# zizmor: security of the workflows (ci.yml).
TOOL_IMAGE_ZIZMOR=ghcr.io/zizmorcore/zizmor:1.31.1@sha256:42d409dbb851d4c5d35a058cf042b828bea1e3f2884378c526eb0974780e18d9
# cosign: signatures and SBOM attestations of the release images (scripts/release-cosign.sh).
TOOL_IMAGE_COSIGN=ghcr.io/sigstore/cosign/cosign:v3.1.4@sha256:0f06154836d2de34f887a5c273506d52ca43edaa1d9e53e6510fa78a48f69c2d
