#
# Build context of deploy/server/Dockerfile is the repository root: send only
# what its COPY lines read, so node_modules, .git and build output stay out
# (web/ is the console's source; its node_modules and dist are rebuilt in the image).
*
!gradlew
!settings.gradle.kts
!build.gradle.kts
!gradle.properties
!gradle/
!proto/sard/
!proto/jvm/
!server/
!web/
web/node_modules/
web/dist/
!agent/plugins/files/schema.json
**/build/
**/.gradle/
**/.kotlin/
